---
// Formulario sin servidor: si hay email en site.yaml abre el programa de correo (mailto) con los campos en el cuerpo.
// Si no hay email, se queda como muestra y lo avisa. Para un envío real, cambia `action` por el de tu proveedor.
// Modelos:
//  - `traslado` (reservar): nombre, teléfono, origen, destino, día, hora, viajeros y comentarios (vuelo o tren, equipaje…).
//  - `contacto`: nombre, email o teléfono y mensaje.
// `prefijo` hace únicos los ids cuando hay varios formularios en la misma página.
import { site } from '../../data/site';
interface Props { boton?: string; class?: string; asunto?: string; modelo?: 'traslado' | 'contacto'; prefijo?: string }
const {
  boton = 'Enviar',
  class: clase = '',
  asunto = `Reserva desde la web de ${site.nombre}`,
  modelo = 'contacto',
  prefijo = 'f',
} = Astro.props;
const email = site.contacto.email;
const accion = email ? `mailto:${email}?subject=${encodeURIComponent(asunto)}` : '';
const id = (campo: string) => `${prefijo}-${campo}`;
---

<form class:list={['formulario', clase]} action={accion || undefined} method="post" enctype="text/plain">
  {
    modelo === 'contacto' ? (
      <div class="campo-doble">
        <div class="campo">
          <label for={id('nombre')}>Nombre</label>
          <input id={id('nombre')} name="nombre" type="text" autocomplete="name" required />
        </div>
        <div class="campo">
          <label for={id('contacto')}>Email o teléfono</label>
          <input id={id('contacto')} name="contacto" type="text" autocomplete="email" required />
        </div>
      </div>
    ) : (
      <>
        <div class="campo-doble">
          <div class="campo">
            <label for={id('nombre')}>Nombre</label>
            <input id={id('nombre')} name="nombre" type="text" autocomplete="name" required />
          </div>
          <div class="campo">
            <label for={id('telefono')}>Teléfono</label>
            <input id={id('telefono')} name="telefono" type="tel" autocomplete="tel" inputmode="tel" required />
          </div>
        </div>
        <div class="campo-doble">
          <div class="campo">
            <label for={id('origen')}>Recogida</label>
            <input id={id('origen')} name="origen" type="text" autocomplete="street-address" required />
          </div>
          <div class="campo">
            <label for={id('destino')}>Destino</label>
            <input id={id('destino')} name="destino" type="text" required />
          </div>
        </div>
        <div class="campo-triple">
          <div class="campo">
            <label for={id('fecha')}>Día</label>
            <input id={id('fecha')} name="fecha" type="date" required />
          </div>
          <div class="campo">
            <label for={id('hora')}>Hora</label>
            <input id={id('hora')} name="hora" type="time" step="300" required />
          </div>
          <div class="campo">
            <label for={id('viajeros')}>Viajeros</label>
            <input id={id('viajeros')} name="viajeros" type="number" min="1" max="20" inputmode="numeric" required />
          </div>
        </div>
      </>
    )
  }
  <div class="campo">
    <label for={id('mensaje')}>{modelo === 'traslado' ? 'Comentarios (vuelo o tren, maletas, sillas para niños, bicis…)' : 'Mensaje'}</label>
    <textarea id={id('mensaje')} name="mensaje" rows={modelo === 'traslado' ? 3 : 4} required={modelo !== 'traslado'}></textarea>
  </div>
  <label class="campo-check">
    <input type="checkbox" name="privacidad" required />
    <span>He leído el <a href="/aviso-legal">aviso legal y la política de privacidad</a>.</span>
  </label>
  <button type="submit" class="btn">{boton}</button>
  <p class="formulario-aviso">
    {
      email
        ? 'Al enviar se abre tu programa de correo con el mensaje listo.'
        : 'Formulario de muestra: todavía no envía mensajes. Usa el teléfono o el email de contacto.'
    }
  </p>
</form>
