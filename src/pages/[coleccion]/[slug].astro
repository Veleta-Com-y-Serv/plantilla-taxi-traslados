---
// Ficha de un elemento con `detalle` (src/lib/paginas.ts, listas de src/data/fichas.ts): /servicios/<slug>/ y
// /traslados/<slug>/. Diseño Wayfind: migas, placa con el tipo, título en Chivo Mono 800, el precio en placa ámbar y
// los botones; la foto en un marco de tinta (sin foto, el texto a lo ancho). Debajo, el `detalle` en párrafos y, al
// lado, los datos en una lista con filetes y el cartel de tinta con el teléfono; galería (`imagenes`) y otras fichas
// de la misma lista en celdas unidas por sus bordes.
import Base from '../../layouts/Base.astro';
import Imagen from '../../components/ui/Imagen.astro';
import Icono from '../../components/ui/Icono.astro';
import { seccion, site, tel, whatsapp } from '../../data/site';
import { fichas, relacionadas, resumen } from '../../lib/paginas';
import type { Ficha } from '../../lib/paginas';
import { altGaleria, jsonLdFicha, jsonLdMigas, urlBase } from '../../lib/seo';
import { enlace, rutaDeSeccion } from '../../lib/multipagina';

export function getStaticPaths() {
  return fichas().map((f) => ({ params: { coleccion: f.def.ruta, slug: f.slug }, props: { f } }));
}

interface Props { f: Ficha }
const { f } = Astro.props;
const base = urlBase(Astro.site);
const nombreSeccion = String(f.seccion.antetitulo || f.seccion.titulo || f.def.nombre).trim();
const migas = [
  { nombre: 'Inicio', ruta: '/' },
  { nombre: nombreSeccion, ruta: rutaDeSeccion(f.idSeccion) },
  { nombre: f.titulo, ruta: f.url },
];
const c = site.contacto;
const reservar = seccion('reservar') ? enlace('/#reservar') : site.boton_cabecera?.url || (seccion('contacto') ? enlace('/#contacto') : '');
const textoReservar = site.boton_cabecera?.texto || 'Reservar';
const wa = whatsapp(c.whatsapp, `Hola, quiero información sobre ${f.titulo}`);
const datos = f.datos.filter((d) => d.clave !== 'precio' && d.clave !== 'disponible');
const disponible = String(f.elemento.disponible ?? '').trim();
const otras = relacionadas(f, 4);
const descripcion = resumen(f.texto || f.detalle[0] || '');
---

<Base titulo={f.titulo} descripcion={descripcion} imagen={f.imagen} ld={[jsonLdMigas(base, migas), jsonLdFicha(base, f)]}>
  <section class="pagina-cabeza">
    <div class="contenedor">
      <nav aria-label="Migas de pan" class="migas">
        <ol>
          {migas.map((m, i) => (
            <li>{i < migas.length - 1 ? <a href={m.ruta}>{m.nombre}</a> : <span aria-current="page">{m.nombre}</span>}</li>
          ))}
        </ol>
      </nav>
      <div class:list={['pagina-hero', { 'pagina-hero--foto': f.imagen }]}>
        <div class="pagina-hero-texto">
          <p class="placa placa--tinta">{f.categoria || disponible || f.def.nombre}</p>
          <h1 class="pagina-titulo">{f.titulo}</h1>
          {f.texto && <p class="portada-parrafo">{f.texto}</p>}
          {f.precio && <p class="pagina-precio"><span class="placa">{f.precio}</span></p>}
          <div class="botones">
            {reservar && <a class="btn" href={reservar}>{textoReservar}</a>}
            {c.telefono && <a class="btn-sec" href={tel(c.telefono)}><Icono nombre="telefono" tam={18} /> {c.telefono}</a>}
          </div>
        </div>
        {f.imagen && (
          <div class="foto marco pagina-foto">
            <Imagen src={f.imagen} alt={f.titulo} ancho={1200} alto={900} prioridad />
          </div>
        )}
      </div>
    </div>
  </section>

  <section class="banda banda--papel">
    <div class="contenedor pagina-cuerpo">
      <article class="pagina-texto">
        {f.detalle.map((p) => <p>{p}</p>)}
      </article>
      <aside class="pagina-lado">
        {(datos.length > 0 || f.precio) && (
          <dl class="datos">
            {f.precio && <div><dt>Precio</dt><dd>{f.precio}</dd></div>}
            {datos.map((d) => <div><dt>{d.etiqueta}</dt><dd>{d.valor}</dd></div>)}
          </dl>
        )}
        {(c.telefono || wa) && (
          <div class="cartel">
            {c.telefono && (
              <>
                <p class="menuda">Reserva por teléfono</p>
                <a class="cartel-tel" href={tel(c.telefono)}>{c.telefono}</a>
              </>
            )}
            <div class="botones">
              {c.telefono && <a class="btn" href={tel(c.telefono)}><Icono nombre="telefono" tam={18} /> Llamar</a>}
              {wa && <a class="btn-sec" href={wa} target="_blank" rel="noopener"><Icono nombre="whatsapp" tam={18} /> WhatsApp</a>}
            </div>
          </div>
        )}
      </aside>
    </div>
  </section>

  {f.imagenes.length > 0 && (
    <section class="banda banda--papel" aria-label={`Fotos de ${f.titulo}`} style="padding-top: 0">
      <div class="contenedor">
        <ul class="galeria-ficha">
          {f.imagenes.map((src, i) => (
            <li class="foto marco"><Imagen src={src} alt={`${f.titulo}: ${altGaleria(i).toLowerCase()}`} ancho={800} alto={800} /></li>
          ))}
        </ul>
      </div>
    </section>
  )}

  {otras.length > 0 && (
    <section class="banda banda--clara">
      <div class="contenedor">
        <div class="cabeza">
          <div class="titular-a">
            <p class="antetitulo">{nombreSeccion}</p>
            <h2 class="titulo-seccion">{String(f.seccion.titulo || nombreSeccion)}</h2>
          </div>
        </div>
        <ul class="otras">
          {otras.map((o) => (
            <li>
              <a href={o.url}>
                <span class="otras-titulo">{o.titulo}</span>
                {o.texto && <span class="otras-dato">{o.texto}</span>}
                {o.precio && <span class="otras-precio">{o.precio}</span>}
              </a>
            </li>
          ))}
        </ul>
        <p class="botones"><a class="btn-sec" href={rutaDeSeccion(f.idSeccion)}>Ver {nombreSeccion.toLowerCase()}</a></p>
      </div>
    </section>
  )}
</Base>
