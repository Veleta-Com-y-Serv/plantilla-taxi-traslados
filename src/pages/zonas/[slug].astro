---
// Página de una zona con `texto` (src/lib/paginas.ts, sección `zonas`): /zonas/<slug>/.
// Diseño Wayfind: migas, placa con la localidad, «Taxi en <zona>» (`titulo_pagina` de la sección, con {zona}), la
// entrada (`texto_pagina`) y los botones; el texto propio de la zona junto a la foto de la sección en marco de tinta;
// los trayectos con precio en el tablero de tinta; los servicios en filas; y las otras zonas con página en celdas.
import Base from '../../layouts/Base.astro';
import Imagen from '../../components/ui/Imagen.astro';
import Icono from '../../components/ui/Icono.astro';
import { seccion, site, tel, whatsapp, trayectos, texto as t } from '../../data/site';
import { enlaceDe, introZona, resumen, tituloZona, zonasConPagina } from '../../lib/paginas';
import type { Zona } from '../../lib/paginas';
import { jsonLdMigas, jsonLdZona, urlBase } from '../../lib/seo';
import { enlace, rutaDeSeccion } from '../../lib/multipagina';

export function getStaticPaths() {
  return zonasConPagina().map((z) => ({ params: { slug: z.slug }, props: { z } }));
}

interface Props { z: Zona }
const { z } = Astro.props;
const base = urlBase(Astro.site);
const titulo = tituloZona(z);
const intro = introZona(z);
const nombreSeccion = String(z.seccion.antetitulo || z.seccion.titulo || 'Zonas').trim();
const migas = [
  { nombre: 'Inicio', ruta: '/' },
  { nombre: nombreSeccion, ruta: rutaDeSeccion(z.idSeccion) },
  { nombre: z.nombre, ruta: z.url },
];
const c = site.contacto;
const foto = z.imagen || String(z.seccion.imagen || '');
const servicios = seccion('servicios');
const listaServicios = servicios ? servicios.items.filter((it) => it?.titulo) : [];
const tarifasSec = seccion('tarifas');
const filas = trayectos().filter((x) => t(x.precio)).slice(0, 6);
const reservar = seccion('reservar') ? enlace('/#reservar') : site.boton_cabecera?.url || (seccion('contacto') ? enlace('/#contacto') : '');
const textoReservar = site.boton_cabecera?.texto || 'Reservar';
const wa = whatsapp(c.whatsapp, `Hola, quiero pedir un taxi en ${z.nombre}`);
const otras = zonasConPagina().filter((x) => x !== z);
---

<Base titulo={titulo} descripcion={resumen(z.texto[0] ?? intro)} imagen={foto} ld={[jsonLdMigas(base, migas), jsonLdZona(base, z)]}>
  <section class="pagina-cabeza">
    <div class="contenedor">
      <nav aria-label="Migas de pan" class="migas">
        <ol>
          {migas.map((m, i) => (
            <li>{i < migas.length - 1 ? <a href={m.ruta}>{m.nombre}</a> : <span aria-current="page">{m.nombre}</span>}</li>
          ))}
        </ol>
      </nav>
      <div class:list={['pagina-hero', { 'pagina-hero--foto': foto }]}>
        <div class="pagina-hero-texto">
          <p class="placa placa--tinta"><Icono nombre="mapa" tam={16} /> {z.nombre}</p>
          <h1 class="pagina-titulo">{titulo}</h1>
          {intro && <p class="portada-parrafo">{intro}</p>}
          <div class="botones">
            {c.telefono && <a class="btn" href={tel(c.telefono)}><Icono nombre="telefono" tam={18} /> {c.telefono}</a>}
            {reservar && <a class="btn-sec" href={reservar}>{textoReservar}</a>}
          </div>
        </div>
        {foto && (
          <div class="foto marco pagina-foto">
            <Imagen src={foto} alt={titulo} ancho={1200} alto={900} prioridad />
          </div>
        )}
      </div>
    </div>
  </section>

  <section class="banda banda--papel">
    <div class="contenedor pagina-cuerpo">
      <article class="pagina-texto">
        {z.texto.map((p) => <p>{p}</p>)}
      </article>
      {(c.telefono || wa) && (
        <aside class="pagina-lado">
          <div class="cartel">
            {c.telefono && (
              <>
                <p class="menuda">Taxi en {z.nombre}</p>
                <a class="cartel-tel" href={tel(c.telefono)}>{c.telefono}</a>
              </>
            )}
            <div class="botones">
              {c.telefono && <a class="btn" href={tel(c.telefono)}><Icono nombre="telefono" tam={18} /> Llamar</a>}
              {wa && <a class="btn-sec" href={wa} target="_blank" rel="noopener"><Icono nombre="whatsapp" tam={18} /> WhatsApp</a>}
            </div>
            {c.horario && <p class="cartel-horario">{c.horario}</p>}
          </div>
        </aside>
      )}
    </div>
  </section>

  {filas.length > 0 && (
    <section class="banda banda--tinta">
      <div class="contenedor">
        <div class="cabeza">
          <div class="titular-a">
            {tarifasSec?.antetitulo && <p class="antetitulo">{tarifasSec.antetitulo}</p>}
            <h2 class="titulo-seccion">{tarifasSec?.titulo || 'Tarifas'}</h2>
          </div>
          {tarifasSec?.texto && <p class="entrada">{tarifasSec.texto}</p>}
        </div>
        <table class="salidas">
          <thead><tr><th scope="col">Destino</th><th scope="col">Precio</th></tr></thead>
          <tbody>
            {filas.map((f) => (
              <tr>
                <td class="salidas-destino">{enlaceDe(f) ? <a href={enlaceDe(f)}>{f.nombre}</a> : f.nombre}</td>
                <td class="salidas-precio">{f.precio}</td>
              </tr>
            ))}
          </tbody>
        </table>
        {tarifasSec?.nota && <p class="tarifas-nota">{tarifasSec.nota}</p>}
      </div>
    </section>
  )}

  {listaServicios.length > 0 && (
    <section class="banda banda--papel">
      <div class="contenedor">
        <div class="cabeza">
          <div class="titular-a">
            {servicios?.antetitulo && <p class="antetitulo">{servicios.antetitulo}</p>}
            <h2 class="titulo-seccion">{servicios?.titulo || 'Servicios'}</h2>
          </div>
        </div>
        <ul class="lineas">
          {listaServicios.map((it) => (
            <li class="linea">
              <span class="celda-icono"><Icono nombre={it.icono || 'taxi'} tam={22} /></span>
              <h3 class="linea-titulo">{enlaceDe(it) ? <a href={enlaceDe(it)}>{it.titulo}</a> : it.titulo}</h3>
              {it.texto ? <p class="linea-texto">{it.texto}</p> : <span />}
              <span />
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  {otras.length > 0 && (
    <section class="banda banda--clara">
      <div class="contenedor">
        <h2 class="titulo-seccion" style="font-size: clamp(1.25rem, 1rem + 1vw, 1.75rem)">{nombreSeccion}</h2>
        <ul class="celdas" style="margin-top: 1.5rem">
          {otras.map((o) => (
            <li><a class="celdas-nombre" href={o.url}><span>{o.nombre}</span><span class="menuda">{tituloZona(o)}</span></a></li>
          ))}
        </ul>
      </div>
    </section>
  )}
</Base>
